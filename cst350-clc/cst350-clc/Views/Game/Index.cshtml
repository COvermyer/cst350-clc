@{
	ViewData["Title"] = "Minesweeper Game";
	int Size = ViewBag.GameBoard.Size;
	// int Size = 7;

	// Size of each button in pixels (width and height)
	int buttonSize = 60;
	string buttonSizePx = buttonSize + "px";
}
<style>
	.minesweeper-grid-wrapper{
		display: flex;
		justify-content: center;
		align-items: flex-start;
		height: 100vh;
	}

	.minesweeper-grid-container{
		display: grid;
		gap: 6px;
		margin-top: 12px;
	}
	.minesweeper-grid-button{
		width: @buttonSizePx;
		height: @buttonSizePx;
		font-weight: bold;
		cursor: pointer;
		text-align: center;
		vertical-align: center;
	}
</style>

<div class="justify-content-center">
	<h1 class="text-center display-4">@ViewData["Title"]</h1>
	<hr/>

	<div class="minesweeper-grid-wrapper">
		<div id="grid justify-content-center" class="minesweeper-grid-container" style="grid-template-columns:repeat(@Size, @buttonSizePx)">
			@for (int row = 0; row < Size; row++)
			{
				for (int col = 0; col < Size; col++)
				{
					// Create a button for each cell in the grid, assign the btn an ID based on its row and column
					<button class="minesweeper-grid-button" data-row="@row" data-col="@col" id="@String.Format("btn_{0}_{1}", row, col)">
						@ViewBag.GameBoard.Cells[row, col].NumberOfBombNeighbors
					</button>
				}
			}
		</div>
	</div>
</div>

<script>
	document.getElementById('grid').addEventListener('click', async (ev) => {
		const btn = ev.target.closest('.minesweeper-grid-button');
		if (!btn) return; // Not a button

		console.log("[" + btn.getAttribute("data-row"), ", " + btn.getAttribute("data-col") + "] clicked");
	});
</script>
