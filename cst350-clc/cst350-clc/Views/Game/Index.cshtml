@{
	ViewData["Title"] = "Minesweeper Game";
	int Size = ViewBag.GameBoard.Size;

	var cellSize = 100 / Size; // Calculate button width percentage
}
<link rel="stylesheet" href="~/css/minesweeper.css"/>

<div class="dflex justify-content-center align-items-center">
	<h1 class="text-center display-4">@ViewData["Title"]</h1>
	<hr/>

	<!-- DYNAMICALLY GENERATE THE MINESWEEPER BOARD -->
	<div class="game-wrapper">
		<form asp-action="GameCellClick" method="post" class="minesweeper-form">
			<div class="minesweeper-container" style="grid-template-columns: repeat(@Size, 1fr); border: 2px solid #ccc;">
				@for (int row = 0; row < Size; row++)
				{ // individual row
					@for (int col = 0; col < Size; col++)
					{ // individual cells
						var cell = ViewBag.GameBoard.Cells[row, col];
						<div class="game-button" data-id="@String.Format("cell_{0}_{1}", row, col)">
							<button class="minesweeper-button" type="submit" name="id" value="@String.Format("cell_{0}_{1}", row, col)">
							@{
								var imageSrc = "cellBomb.png";
								//Determine which Image to pull based on the cell location and state
								if (cell.IsVisited == false)
								{
									imageSrc = "cellUnvisited.png";
								} 
								else
								{
									if (cell.IsBomb == true)
										imageSrc = "cellBomb.png";
									else if (cell.NumberOfBombNeighbors > 0)
										imageSrc = $"cell{cell.NumberOfBombNeighbors}.png";
									else
										imageSrc = "cellVisited.png";
									}
								<img src="~/img/@imageSrc" />
							}
							</button>
						</div>
					}
				}
			</div>
		</form>
	</div>

	@{
		// Display game status messages
		if (ViewBag.GameBoard.DetermineGameState() == MineSweeper.GameState.Won)
		{
			<h2 class="text-center text-success mt-3">Congratulations! You Won!</h2>
			<h3 class="text-center">Final Score: @MineSweeper.Board.CalculateScore(ViewBag.GameBoard)</h3>
		} else if (ViewBag.GameBoard.DetermineGameState() == MineSweeper.GameState.Lost)
		{
			<h2 class="text-center text-danger mt-3">Game Over! You hit a bomb!</h2>
		} else
		{
			<h2 class="text-center text-info mt-3">Game in Progress...</h2>
		}
	}

	<hr />
	<h5 class="text-center">New Game</h5>
	<div class="game-wrapper">
		<form asp-action="NewGame" method="post" class="text-center mt-4 newgame-form">
			<div class="form-group mb-3">
				<label for="Size" class="form-label">Board Size</label>
				<input type="number" id="Size" name="Size" class="form-control d-inline-block w-auto text-center" min="2" max="50" value="10" required />
			</div>

			<div class="form-group mb-3">
				<label for="Difficulty" class="form-label">Difficulty</label>
				<select id="Difficulty" name="Difficulty" class="form-select d-inline-block w-auto text-center">
					<option value="1">Easy</option>
					<option value="2">Medium</option>
					<option value="3">Hard</option>
					<option value="4">Insane</option>
					<option value="5">Impossible</option>
				</select>
			</div>

			<button type="submit" class="btn btn-primary">New Game</button>
		</form>
	</div>
</div>
