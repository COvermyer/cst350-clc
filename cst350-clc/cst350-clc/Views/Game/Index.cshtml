@model MineSweeper.Board
@{
    ViewData["Title"] = "Minesweeper Game";

    // Use a safe incoming value if your controller sets it; otherwise default Easy(1)
    int selectedDifficulty = 1; //FIXME
}
<link rel="stylesheet" href="~/css/minesweeper.css" />

<div class="d-flex flex-column justify-content-center align-items-center">
    <h1 class="text-center display-4">@ViewData["Title"]</h1>
    <hr />

    <div class="game-wrapper">
        @Html.Partial("_GameBoard", Model)
    </div>

    <hr />
	<div class="newgame-wrapper newgame-form">
        <h5 class="text-center">New Game</h5>
        <hr />
        <form asp-action="NewGame" method="post" class="text-center mt-4 ">
            
            <div class="form-group mb-3">
                <label for="Size" class="form-label">Board Size</label>
                <input type="number" id="Size" name="Size" class="form-control" min="5" max="20" value="@Model.Size" />
            </div>
            <div class="form-group mb-3">
                <label for="Difficulty" class="form-label">Difficulty</label>
                <select id="Difficulty" name="Difficulty" class="form-select">
                    <option value="1">Easy</option>
                    <option value="2">Medium</option>
                    <option value="3">Hard</option>
                    <option value="4">Insane</option>
                    <option value="5">Impossible</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Start New Game</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Set selected option without Razor C# in attributes (avoids RZ1031 warnings)
        (function () {
            var sel = document.getElementById('Difficulty');
            if (sel) sel.value = '@selectedDifficulty';
        })();
    </script>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            function isGameOver() {
                return $(".minesweeper-container").hasClass("game-disabled");
            }

            // Condenses ajax calls
            function sendMove(url, row, col) {
                if (isGameOver()) return;
                $.ajax({
                    type: "POST",
                    url: url,
                    data: { row: row, col: col },
                    success: function (result) {
                        $(".game-wrapper").html(result);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error:", error);
                    }
                });
            }

            // Left Click action
            $(document).on('click', ".game-button button", function (e) {
                e.preventDefault();
                var row = $(this).data("row");
                var col = $(this).data("col");
                sendMove("/Game/GameCellVisit", row, col);
            });

            // Right Click action
            $(document).on('contextmenu', ".game-button button", function (e) {
                e.preventDefault();
                var row = $(this).data("row");
                var col = $(this).data("col");
                sendMove("/Game/GameCellFlag", row, col);
            });
        });
    </script>
}
